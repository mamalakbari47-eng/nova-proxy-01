{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy-01",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "38bedfed-76f5-4021-bf08-a724fbdec8be","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3d5cfebf753a44309d3f3dc3c4bfa917" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
